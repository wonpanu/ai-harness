# Model assignment per agent role — the single place to change who runs on what.
# install.sh reads this when generating ~/.claude/agents/*.md (run `make install` after editing).
# Personal overrides go in models.local.env (gitignored) with the same variable names.
# Variable prefix = agent filename, uppercased, hyphens to underscores.
#
# Fallback chain: models.local.env → models.env → the agent file's own frontmatter.
# A variable that is missing, or set to empty, falls through to the next level —
# the frontmatter in agents/*.md always carries the agreed defaults, so deleting
# this whole file still produces a working install.

DEEP_REASONER_MODEL=claude-opus-5
DEEP_REASONER_EFFORT=xhigh

FAST_WORKER_MODEL=claude-opus-5
FAST_WORKER_EFFORT=medium

WEB_SEARCHER_MODEL=claude-haiku-4-5-20251001

CODE_COMMITTER_MODEL=claude-haiku-4-5-20251001

SENIOR_LEAD_REVIEWER_MODEL=claude-opus-5
SENIOR_LEAD_REVIEWER_EFFORT=xhigh
